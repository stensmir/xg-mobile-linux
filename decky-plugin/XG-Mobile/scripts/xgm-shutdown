#!/bin/bash
# xgm-shutdown — Safe eGPU teardown on reboot/shutdown.
#
# The problem we solve: at shutdown.target, this unit runs in parallel with
# the systemd-driven teardown of user@1000.service (gamescope, steam,
# Xwayland, decky). For 1–3 seconds after we start, those DRM clients are
# still alive and holding nvidia-drm via refcount. modprobe -r fails, then
# anything we do with /sys/.../remove wedges nv_pci_remove → os_delay loop
# in the kernel and shutdown later hangs on unmount /opt.
#
# Approach:
#   1. Kill known DRM clients aggressively (gamescope, steam, Xwayland).
#   2. Retry modprobe -r every second for up to 15s — gives systemd time to
#      wind down user@1000 in parallel and release the last refs.
#   3. Only PCIe-remove if modules are actually unloaded.
#   4. Cut dock power only after successful driver/device teardown.

SYSFS_ENABLE="/sys/devices/platform/asus-nb-wmi/egpu_enable"
VENDOR_FILE="/home/deck/.config/xgm/vendor"
LOGFILE="/var/log/xgm-shutdown.log"

log() { echo "$(date '+%F %T') xgm-shutdown: $*" | tee -a "$LOGFILE"; }

# Vendor (default nvidia for backward compat)
VENDOR=nvidia
if [ -r "$VENDOR_FILE" ]; then
    v=$(tr -d '[:space:]' < "$VENDOR_FILE")
    case "$v" in
        nvidia|amd) VENDOR="$v" ;;
    esac
fi

if [ "$VENDOR" = "nvidia" ]; then
    REMOVE_VENDOR="0x10de"
else
    REMOVE_VENDOR="0x1002"
fi

modules_left=0

# Step 1 (nvidia only): release nvidia-drm refcount and unload modules.
# Retry loop because systemd may still be tearing down user@1000 in parallel.
if [ "$VENDOR" = "nvidia" ] && lsmod | grep -q "^nvidia"; then
    # Kill DRM clients aggressively. Idempotent — safe to call repeatedly.
    pkill -KILL gamescope 2>/dev/null
    pkill -KILL steam 2>/dev/null
    pkill -KILL steamwebhelper 2>/dev/null
    pkill -KILL Xwayland 2>/dev/null

    log "waiting for nvidia driver to release (up to 15s)..."
    unloaded=0
    for i in $(seq 1 15); do
        # Re-kill in case new clients appeared (e.g. systemd re-trying)
        for client in gamescope steam steamwebhelper Xwayland kwin_wayland; do
            pkill -KILL "$client" 2>/dev/null
        done
        # Try to unload — short timeout, idempotent
        timeout 3 modprobe -r nvidia-uvm nvidia-drm nvidia-modeset nvidia 2>/dev/null
        if ! lsmod | grep -q "^nvidia"; then
            log "nvidia modules unloaded after ${i}s"
            unloaded=1
            break
        fi
        sleep 1
    done

    if [ "$unloaded" = "0" ]; then
        log "WARN: nvidia modules still loaded after 15s retry loop — skipping PCIe remove (would hang kernel)"
        modules_left=1
    fi
fi

# Step 2: PCIe-remove dock GPU(s) only if it's safe (no driver bound).
# AMD path always reaches here because amdgpu releases cleanly on remove.
# Skip 0000:09:* (integrated AMD iGPU on Z1 Extreme).
teardown_failed=$modules_left
if [ "$modules_left" = "0" ]; then
    for dev in /sys/bus/pci/devices/*; do
        vendor=$(cat "$dev/vendor" 2>/dev/null)
        bdf=$(basename "$dev")
        if [ "$vendor" = "$REMOVE_VENDOR" ] && [[ "$bdf" != 0000:09:* ]]; then
            # Unbind whatever driver holds this function BEFORE removing it.
            # The GPU HDMI-audio function (...:00.1) is bound by snd_hda_intel,
            # which has no AER error_detected callback — removing it while bound
            # throws an Uncorrectable AER / ACSViol on the upstream port and
            # hangs the final kernel reboot/poweroff on SteamOS kernel valve23+.
            # Unbinding first lets the function detach cleanly.
            if [ -L "$dev/driver" ]; then
                drv=$(basename "$(readlink "$dev/driver")")
                log "Unbinding $drv from $bdf"
                if ! timeout 5 sh -c "echo '$bdf' > '$dev/driver/unbind'" 2>/dev/null || [ -L "$dev/driver" ]; then
                    log "WARN: $bdf remains bound; skipping removal and dock power-off"
                    teardown_failed=1
                    continue
                fi
            fi
            log "Removing PCIe device $bdf"
            if ! timeout 5 sh -c "echo 1 > '$dev/remove'" 2>/dev/null; then
                teardown_failed=1
            fi
        fi
    done
fi

# Step 3: Never cut power while a driver or failed removal still holds the dock.
if [ "$teardown_failed" = "0" ] && [ -f "$SYSFS_ENABLE" ]; then
    timeout 3 sh -c "echo 0 > '$SYSFS_ENABLE'" 2>/dev/null
    log "egpu_enable = 0 (dock powered off)"
fi

log "Shutdown cleanup complete (vendor=$VENDOR, modules_left=$modules_left)"
